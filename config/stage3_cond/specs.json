{
  "Description" : "end-to-end training (conditional) on couch dataset",
  "DataSource": "data/acronym/mug",
  "GridSource": "data/grid_data/acronym/mug",
  "TrainSplit" : "data/splits/mug_augmented.json",
  "TestSplit" : "data/splits/mug_augmented.json",
  "modulation_path" : "config/stage1_sdf/modulations",
  "validation_path" : "data/splits/mug_1.json",

  "modulation_ckpt_path" : "config/stage1_sdf/last.ckpt",
  "diffusion_ckpt_path" : "config/stage2_diff_cond/last.ckpt",
  
  "training_task": "combined",

  "num_epochs" : 100001,
  "log_freq" : 5000,

  "kld_weight" : 1e-5,
  "latent_std" : 0.5,
  
  "sdf_lr" : 1e-4,
  "diff_lr" : 1e-5,

  "SdfModelSpecs" : {
      "hidden_dim" : 512,
      "latent_dim" : 256,
      "num_layers" : 9
    },
  "SampPerMesh" : 16000,
  "PCsize" : 1024,

  "diffusion_specs" : {
    "timesteps" : 1000,
    "objective" : "pred_x0",
    "loss_type" : "l2",
    "perturb_pc" : "partial",
    "crop_percent": 0.5,
    "sample_pc_size" : 128
  },
  "diffusion_model_specs": {
    "dim" : 256,
    "depth" : 4,
    "ff_dropout" : 0,
    "cond" : true,
    "cross_attn" : true,
    "cond_dropout":false,
    "point_feature_dim" : 128
  }
}


